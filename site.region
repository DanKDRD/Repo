<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {squarespace-headers}
    <link rel="stylesheet" type="text/css" href="https://static1.squarespace.com/static/sitecss/528d2a97e4b06be250ab2734/83/51e6b9e4e4b062dafa7099b9/528d2a97e4b06be250ab2739/1245/site.css?nocustom=true">
    <style>
      body {
        margin: 0;
      }

      #canvasWrapper {
        min-height: 100vh;
      }

      #header {
        padding: 24px 34px 10px;
      }

      #logo img {
        max-width: 220px;
        height: auto;
      }

      .main-nav ul {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        margin: 18px 0 0;
        padding: 0;
        list-style: none;
      }

      .main-nav a {
        text-decoration: none;
      }

      #page {
        padding: 0 34px 34px;
      }

      #mainContent {
        max-width: 1180px;
        margin: 0 auto;
      }

      #footer {
        padding: 24px 34px 40px;
        text-align: center;
      }

      @media (max-width: 640px) {
        #header,
        #page,
        #footer {
          padding-left: 18px;
          padding-right: 18px;
        }

        .main-nav ul {
          gap: 12px;
        }
      }
    </style>
  </head>
  <body id="{squarespace.page-id}" class="{squarespace.page-classes}">
    <div id="canvasWrapper">
      <div id="siteWrapper">
        <header id="header">
          <div id="logo" data-content-field="site-title">
            <a href="/">
              <img src="https://images.squarespace-cdn.com/content/v1/528d2a97e4b06be250ab2734/e10db2cf-2b5b-4ae8-ac26-8e4409ba4968/New+Logo.JPG?format=1500w" alt="Home Design &amp; Drywall Art">
            </a>
          </div>
          <nav class="main-nav" data-content-field="navigation" aria-label="Main navigation">
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/aboutbellarosa">About</a></li>
              <li><a href="/services">Services</a></li>
              <li><a href="/contact">Contact Us</a></li>
              <li><a href="/gallery">Gallery</a></li>
              <li><a href="/youtubevideos">Videos</a></li>
            </ul>
          </nav>
        </header>

        <section id="page">
          <div id="mainContent" role="main" data-content-field="main-content">
            {squarespace.main-content}
          </div>
        </section>

        <footer id="footer">
          <p>© Bella Rosa Developments Ltd. 2022 | videos by <a href="https://www.streamworks.ca">streamworks.ca</a></p>
          <p><strong>Phone:</strong> <a href="tel:+14035880407">403-588-0407</a></p>
        </footer>
      </div>
    </div>
    {squarespace-footers}
  </body>
</html>
