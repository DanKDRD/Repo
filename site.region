<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta name="description" content="The new Bella Rosa Developments website is under construction. Contact Mike Edwards about custom homes and renovations in Central Alberta.">
    <link rel="canonical" href="https://www.bellarosadevelopments.ca/">
    <title>Website Under Construction | Bella Rosa Developments</title>
    <style>
      :root {
        color-scheme: light;
        --paper: #f3efe7;
        --ink: #202923;
        --muted: #626d65;
        --green: #304b3d;
        --terracotta: #a64f3a;
        --line: rgba(32, 41, 35, 0.16);
      }

      * { box-sizing: border-box; }

      html {
        min-width: 320px;
        background: var(--paper);
      }

      body {
        min-height: 100vh;
        min-height: 100svh;
        margin: 0;
        color: var(--ink);
        background:
          linear-gradient(90deg, transparent 0 49.92%, rgba(32, 41, 35, 0.045) 50%, transparent 50.08%),
          radial-gradient(circle at 12% 12%, rgba(166, 79, 58, 0.12), transparent 27rem),
          var(--paper);
        font-family: Arial, Helvetica, sans-serif;
      }

      a { color: inherit; }

      .page {
        width: min(100% - 2rem, 1180px);
        min-height: 100vh;
        min-height: 100svh;
        margin-inline: auto;
        padding: clamp(1.5rem, 4vw, 3rem) 0;
        display: grid;
        grid-template-rows: auto 1fr auto;
      }

      .brand {
        width: fit-content;
        text-decoration: none;
        display: inline-flex;
        flex-direction: column;
        line-height: 1;
      }

      .brand__name {
        color: var(--terracotta);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(1.75rem, 3vw, 2.4rem);
        letter-spacing: -0.035em;
      }

      .brand__sub {
        margin-top: 0.35rem;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.2em;
        text-transform: uppercase;
      }

      main {
        align-self: center;
        padding: clamp(3rem, 9vw, 7rem) 0;
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
        gap: clamp(2.5rem, 8vw, 7rem);
        align-items: end;
      }

      .eyebrow {
        margin: 0 0 1.4rem;
        color: var(--terracotta);
        display: flex;
        align-items: center;
        gap: 0.85rem;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.2em;
        text-transform: uppercase;
      }

      .eyebrow::before {
        width: 2.75rem;
        height: 2px;
        background: currentColor;
        content: "";
      }

      h1 {
        max-width: 11ch;
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(3.7rem, 8.5vw, 7.9rem);
        font-weight: 400;
        letter-spacing: -0.055em;
        line-height: 0.92;
      }

      .intro {
        max-width: 40rem;
        margin: clamp(1.7rem, 4vw, 2.6rem) 0 0;
        color: var(--muted);
        font-size: clamp(1.05rem, 1.6vw, 1.3rem);
        line-height: 1.65;
      }

      .contact-card {
        position: relative;
        padding: clamp(2rem, 4.5vw, 3.5rem);
        color: #fff;
        background: var(--green);
        box-shadow: 1.2rem 1.2rem 0 rgba(166, 79, 58, 0.17);
        overflow: hidden;
      }

      .contact-card::after {
        position: absolute;
        right: -5rem;
        bottom: -6rem;
        width: 14rem;
        height: 14rem;
        border: 1px solid rgba(255, 255, 255, 0.13);
        border-radius: 50%;
        box-shadow: 0 0 0 2.5rem rgba(255, 255, 255, 0.035), 0 0 0 5rem rgba(255, 255, 255, 0.025);
        content: "";
      }

      .contact-card > * {
        position: relative;
        z-index: 1;
      }

      .contact-card__label {
        margin: 0 0 1.2rem;
        color: #e9c0b5;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      h2 {
        max-width: 13ch;
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2rem, 4vw, 3.2rem);
        font-weight: 400;
        line-height: 1.05;
      }

      .contact-card p:not(.contact-card__label) {
        max-width: 30rem;
        margin: 1.35rem 0 2rem;
        color: rgba(255, 255, 255, 0.76);
        line-height: 1.65;
      }

      .contact-list {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .contact-list li + li {
        border-top: 1px solid rgba(255, 255, 255, 0.18);
      }

      .contact-list a {
        padding: 1rem 0;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        font-size: clamp(1rem, 1.6vw, 1.15rem);
        font-weight: 700;
        text-decoration: none;
      }

      .contact-list a::after { content: "↗"; }

      .contact-list a:hover,
      .contact-list a:focus-visible { color: #f2c5b8; }

      .contact-list a:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 0.35rem;
      }

      footer {
        padding-top: 1.2rem;
        border-top: 1px solid var(--line);
        color: var(--muted);
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        font-size: 0.8rem;
        line-height: 1.5;
      }

      footer p { margin: 0; }

      @media (max-width: 800px) {
        body {
          background:
            radial-gradient(circle at 12% 8%, rgba(166, 79, 58, 0.12), transparent 22rem),
            var(--paper);
        }

        main {
          grid-template-columns: 1fr;
          align-items: start;
        }

        h1 { max-width: 9ch; }

        .contact-card {
          box-shadow: 0.7rem 0.7rem 0 rgba(166, 79, 58, 0.17);
        }
      }

      @media (max-width: 520px) {
        main { padding: 3.5rem 0 4rem; }

        h1 { font-size: clamp(3.35rem, 18vw, 5rem); }

        .contact-card {
          margin-right: 0.45rem;
          padding: 1.75rem;
        }

        footer { flex-direction: column; }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { scroll-behavior: auto !important; }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header>
        <a class="brand" href="/" aria-label="Bella Rosa Developments home">
          <span class="brand__name">Bella Rosa</span>
          <span class="brand__sub">Developments Ltd.</span>
        </a>
      </header>

      <main>
        <section aria-labelledby="construction-heading">
          <p class="eyebrow">Red Deer · Central Alberta</p>
          <h1 id="construction-heading">A new site is taking shape.</h1>
          <p class="intro">Our website is currently under construction. Bella Rosa continues to build and renovate thoughtfully crafted homes throughout Red Deer and Central Alberta.</p>
        </section>

        <aside class="contact-card" aria-labelledby="contact-heading">
          <p class="contact-card__label">Projects are still moving</p>
          <h2 id="contact-heading">Have a home project in mind?</h2>
          <p>Contact Mike directly to start a conversation about a custom home, renovation, basement development, or detailed construction work.</p>
          <ul class="contact-list">
            <li><a href="tel:+14035880407">403-588-0407</a></li>
            <li><a href="mailto:mike@bellarosadevelopments.ca">mike@bellarosadevelopments.ca</a></li>
          </ul>
        </aside>
      </main>

      <footer>
        <p>© 2026 Bella Rosa Developments Ltd.</p>
        <p>Owner-led construction in Central Alberta.</p>
      </footer>
    </div>
  </body>
</html>
