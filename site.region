<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bella Rosa Developments Ltd.</title>
    <style>
      html,
      body {
        width: 100%;
        height: 100%;
        margin: 0;
        overflow: hidden;
        background: #f5f1ea;
      }

      .site-frame {
        display: block;
        width: 100%;
        height: 100vh;
        height: 100dvh;
        border: 0;
        background: #f5f1ea;
      }

      .direct-link {
        position: absolute;
        left: -10000px;
        top: auto;
      }

      .direct-link:focus {
        left: 1rem;
        top: 1rem;
        z-index: 2;
        padding: 0.75rem 1rem;
        color: #fff;
        background: #111;
      }
    </style>
  </head>
  <body>
    <a class="direct-link" href="https://dr-dns.com/bellarosa/">Open the Bella Rosa site directly</a>
    <iframe
      class="site-frame"
      id="bellarosa-site"
      title="Bella Rosa Developments"
      src="https://dr-dns.com/bellarosa/"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
    <script>
      (function () {
        var frame = document.getElementById('bellarosa-site');
        var path = window.location.pathname || '/';
        var target = 'https://dr-dns.com/bellarosa' + path + window.location.search + window.location.hash;
        frame.src = target;
      }());
    </script>
    <noscript>
      <p><a href="https://dr-dns.com/bellarosa/">Open the Bella Rosa Developments website</a></p>
    </noscript>
  </body>
</html>
